<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgReward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/rewardbox"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="UNLOCKED"
                android:textColor="#3B82F6"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </RelativeLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvRewardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Movie Night"
            android:textColor="#111111"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <!-- Desc -->
        <TextView
            android:id="@+id/tvRewardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Free digital rental on any platform."
            android:textColor="#777777"
            android:textSize="13sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#EEEEEE"/>

        <!-- Bottom -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/tvPointsNeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✪ 300"
                android:textColor="#0F5CC0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>

            <Button
                android:id="@+id/btnAction"
                android:layout_width="110dp"
                android:layout_height="46dp"
                android:layout_alignParentEnd="true"
                android:text="Redeem"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/gradent_button"/>
        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>